// 재고관리 대시보드 데이터 모델
// 설계 원칙:
// - 멀티테넌시: 모든 데이터는 하나의 Organization(워크스페이스)에 속한다. 최상위 모델(User·Warehouse·
//   Settings·Holiday·Post·EventSchedule·매장 발주 모델)은 organizationId를 직접 갖고, 나머지(Sku·스냅샷·
//   이벤트 등)는 Warehouse를 통해 조직에 묶인다. 조회/수정은 항상 세션의 조직으로 제한해야 한다.
// - 창고들은 서로 다른 품목군을 관리하는 독립 Pool → 창고 간 직접 비교용 필드/뷰를 두지 않는다.
// - SKU 식별자는 warehouse_id + productCode 조합이며 상품명은 PK가 아니다(상품명 변경에도 이력 유지).
// - Excel 업로드 1건 = 특정 창고의 특정 기준일(snapshotDate) 스냅샷. 같은 (창고, 기준일)이 재업로드되면
//   기존 스냅샷을 REPLACED로 남기고 새 버전을 ACTIVE로 만든다(덮어쓰기로 이력을 지우지 않는다).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER // 조회만 가능(업로드·수정 불가)
  MEMBER
  ADMIN
}

/// 워크스페이스가 주로 쓰는 재고 관리 방식. 가입 시 고르며, 사이드바에서 대시보드를 바꿔 볼 수 있다.
enum BusinessSegment {
  DAILY_SYNC // 매일 재고 파일을 받는 경우 (3PL·OMS)
  PERIODIC_COUNT // 재고를 가끔 직접 세는 경우 (자체 창고)
  ORDER_CYCLE // 재고를 세기 어려워 발주 주기로 예측하는 경우 (카페·음식점)
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  segment          BusinessSegment   @default(DAILY_SYNC)
  // 설정에서 끈 대시보드 유형. 비어 있으면 모두 사용. 끄면 화면에서만 숨기고 데이터는 그대로 둔다.
  disabledSegments BusinessSegment[] @default([])
  // 운영자가 정지하면 소속 사용자는 로그인·이용이 막힌다(데이터는 그대로). null이면 정상.
  suspendedAt      DateTime?
  // 운영자 콘솔에서 만든 샘플 데이터용 워크스페이스. 가입 통계에서 제외한다.
  isDemo           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  users           User[]
  warehouses      Warehouse[]
  settings        Settings?
  holidays        Holiday[]
  posts           Post[]
  schedules       EventSchedule[]
  suppliers       Supplier[]
  importTemplates ImportTemplate[]
  dailySales      DailySales[]
  invitations     Invitation[]
  uploadFiles     UploadFile[]
  uploadJobs      UploadJob[]

  @@map("organizations")
}

enum SnapshotStatus {
  ACTIVE
  REPLACED
}

enum EventType {
  INBOUND // 입고
  RETURN // 반품
  ADJUSTMENT // 재고조정
  PROMOTION // 프로모션
  SOLD_OUT // 품절
  OTHER // 기타
}

enum EventChangeType {
  CREATE
  UPDATE
  DELETE
}

enum PostTag {
  ISSUE // 이슈
  NOTICE // 공지
  CHAT // 잡담
  RESOLVED // 해결
}

model User {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  email           String       @unique
  passwordHash    String
  name            String
  role            Role         @default(MEMBER)
  // 삭제 요청 시 업로드/이벤트 등 참조 이력이 있으면 실제 행을 지울 수 없어 대신 false로
  // 바꾼다(로그인 차단 + 목록에서 제외). 참조 이력이 없으면 행 자체를 삭제한다.
  isActive        Boolean      @default(true)
  // 서비스 운영자(모든 워크스페이스 조회·제어). 가입 이메일로는 판단하지 않고 이 값으로만 판단하며,
  // 앱 화면에서는 바꿀 수 없고 scripts/grant-platform-admin.ts로만 부여한다.
  isPlatformAdmin Boolean      @default(false)
  lastLoginAt     DateTime?
  // 가입·초대 수락 때 받은 메일의 링크로 확인한 시각. 초대로 들어온 사용자는 초대 메일로 확인된 것으로 본다.
  emailVerifiedAt DateTime?
  // 이용약관·개인정보 처리방침 동의 시각(가입·초대 수락 때 기록).
  termsAcceptedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  uploadedSnapshots InventorySnapshot[]
  events            InventoryEvent[]
  eventHistories    EventHistory[]
  posts             Post[]
  favorites         SkuFavorite[]
  packagingUploads  SkuPackagingUpload[]
  purchaseOrders    PurchaseOrder[]
  storeStockCounts  StoreStockCount[]
  platformActions   PlatformAuditLog[]
  authTokens        AuthToken[]
  sentInvites       Invitation[]
  uploadJobs        UploadJob[]

  @@index([organizationId])
  @@map("users")
}

enum WarehouseKind {
  STOCK
  STORE
}

model Warehouse {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  code           String // 조직 안에서의 내부 고정 식별자: A, B, C, D…
  name           String // 화면 표시명 (설정에서 변경 가능)
  sortOrder      Int             @default(0)
  // STOCK: 재고 파일·실사를 받는 실제 창고. STORE: 매장 발주 예측의 품목을 담는 가상 창고(조직마다 하나, 재고 화면에는 안 나옴).
  kind           WarehouseKind   @default(STOCK)
  // 이 창고를 쓰는 관리 방식 — 일일 재고 연동(DAILY_SYNC) 창고와 비정기 실사(PERIODIC_COUNT) 창고는 서로의 화면·양식·원가에 섞이지 않는다.
  // 매장 품목 가상 창고(STORE)는 ORDER_CYCLE.
  segment        BusinessSegment @default(DAILY_SYNC)
  // 이력(스냅샷·이벤트)이 있어 행을 지울 수 없으므로 "삭제"는 보관으로 처리한다. 보관된 창고는
  // 대시보드·업로드·설정 목록에서 빠지고 데이터는 그대로 남는다.
  isArchived     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  skus            Sku[]
  snapshots       InventorySnapshot[]
  events          InventoryEvent[]
  packagingUpload SkuPackagingUpload?
  codeAliases     SkuCodeAlias[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, segment])
  @@map("warehouses")
}

model Sku {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productCode String // 원본 텍스트 그대로 보존 (leading zero 등)

  // 가장 최근 스냅샷에서 관측된 서술 속성 (임포트마다 갱신되는 "현재값" 캐시)
  currentProductName String
  currentOption      String?
  currentBarcode     String?
  currentLocation    String?
  currentUnitCost    Decimal     @default(0) @db.Decimal(14, 2)
  // 현재 원가가 어디서 왔는지 — 재고 파일(FILE) 또는 설정에서 직접 입력(MANUAL). 원가가 없으면 null.
  unitCostSource     CostSource?
  unitCostUpdatedAt  DateTime?
  currentWarningQty  Int         @default(0)
  currentDangerQty   Int         @default(0)

  // 관리자가 SKU 상세에서 직접 지정한 위험/경고수량. null이면 소진 속도 기반 자동계산을 쓴다.
  // 업로드로 값이 채워지지 않는 한 스냅샷과 무관하게 SKU 자체에 붙는 값이라 재업로드해도 유지된다.
  manualWarningQty Int?
  manualDangerQty  Int?

  // 관리자가 SKU 상세에서 직접 지정하는 '특수 관리 재고' 마커(정기 발주·B2B 납품·무상 제공 등). 업로드/자동판정 없이
  // 수동 토글로만 바뀐다. 컬럼 이름은 처음 B2B 마커로 도입될 때 그대로 두었다.
  isB2B       Boolean @default(false)
  // 특수 관리 재고로 두는 이유·일정 메모(예: 매주 월요일 정기 발주). 표시를 꺼도 지우지 않는다.
  specialNote String  @default("")

  firstSeenDate DateTime @db.Date
  lastSeenDate  DateTime @db.Date
  isActive      Boolean  @default(true) // 가장 최근 활성 스냅샷에 존재하는지 (사라진 SKU 판별)

  // 최신 업로드 목록에서 빠져 "품절"로 인식된 날짜(그 날짜의 스냅샷 기준). 재입고되어 다시
  // 업로드 목록에 나타나면 null로 되돌아간다. null이 아니면 이 날짜로부터 1개월 동안은 최신
  // 업로드에 없어도 대시보드에 마지막 관측 데이터 그대로 노출된다(휘발 방지).
  soldOutDetectedDate DateTime? @db.Date

  // 재고 0을 '관리 품목에서 제외'로 처리하는 양식으로 올라와 제외된 날짜. 이 날짜 전으로 조회하면 평소처럼 보이고,
  // 이후로는 대시보드에 보이지 않는다(품절 목록에도 없음). 다시 재고가 생기면 null로 돌아간다.
  removedDate DateTime? @db.Date

  // 창고를 넘어 같은 품목으로 묶는 키. 비어 있으면 상품코드가 같은 품목끼리 묶인다. 창고마다 코드가 다른 같은 품목을 설정에서 직접 묶을 때 쓴다.
  mergeKey String?

  // true면 대시보드(KPI/차트/재고 테이블/Action Center/리포트)에서 이 SKU를 완전히 제외한다.
  // 데이터 자체는 계속 쌓이며 설정 화면에서 언제든 다시 노출로 되돌릴 수 있다.
  isHiddenFromDashboard Boolean @default(false)

  // 매장 품목(STORE 창고)의 발주 단위(박스·kg·팩 등). 재고 창고 SKU는 비어 있다.
  unit String?

  // 이 SKU에 등록된 로트 중 가장 이른(soonest) 소비기한 — expirationLots가 바뀔 때마다
  // 자동으로 다시 계산되는 캐시값이다. 위험 판정 등 도메인 계산은 로트를 직접 보지 않고
  // 이 필드 하나만 읽는다. 로트가 하나도 없으면 null.
  expirationDate DateTime? @db.Date

  // 소비기한까지 남은 일수가 이 값 이하로 들어오면 "임박"으로 본다. null이면 앱의 기본값을 쓴다.
  // 소비기한 관리 화면에서 항목별로, 또는 여러 항목을 선택해 한 번에 설정할 수 있다.
  expirationRiskDays Int?

  // 상품 추가 정보(포장 단위·바코드) — 자주 바뀌지 않는 참고 정보라 화면에서 하나씩 편집하지
  // 않고, 설정 화면에서 창고별 Excel 업로드로만 갱신한다(SkuPackagingUpload가 그 최근 업로드
  // 이력을 기록). 값이 없는 셀로 업로드해도 기존 값을 지우지 않고 그대로 둔다.
  eaPerBox            Int?
  eaPerPallet         Int?
  packagingBarcode    String?
  // 발주 기준 예외 — 비어 있으면 거래처 → 워크스페이스 기본값 순으로 쓴다.
  supplierId          String?
  supplier            Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reorderLeadTimeDays Int?
  reorderSafetyDays   Int?
  reorderTargetDays   Int?
  reorderMinQty       Int?
  reorderMultiple     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items             InventoryItem[]
  events            InventoryEvent[]
  snapshotInbounds  SnapshotInbound[]
  expirationLots    SkuExpirationLot[]
  favoritedBy       SkuFavorite[]
  codeAliases       SkuCodeAlias[]
  purchaseOrders    PurchaseOrder[]
  storeStockCounts  StoreStockCount[]
  attributeVersions SkuAttributeVersion[]

  @@unique([warehouseId, productCode])
  @@index([warehouseId])
  @@map("skus")
}

/// SKU 하나에 여러 로트가 각자 다른 소비기한을 가질 수 있다. 로트명을 직접 입력하지 않은
/// 항목(isAutoLot)은 소비기한 오름차순으로 A, B, C… 라벨이 자동으로 매겨지며, 로트가
/// 추가/삭제/수정될 때마다 다시 계산된다. 직접 입력한 로트명은 재계산 대상에서 제외된다.
model SkuExpirationLot {
  id             String   @id @default(cuid())
  skuId          String
  sku            Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  lot            String
  isAutoLot      Boolean  @default(true)
  expirationDate DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([skuId, lot])
  @@index([skuId])
  @@map("sku_expiration_lots")
}

/// 창고별 "SKU 추가 정보(EA/BOX·EA/PLT·상품바코드)" Excel 업로드 이력. 값 자체는 Sku에 바로
/// 반영되고, 여기는 창고당 한 행만 유지하며 "언제 마지막으로 업데이트됐는지" 확인용으로만 쓴다.
model SkuPackagingUpload {
  id             String    @id @default(cuid())
  warehouseId    String    @unique
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  sourceFileName String
  rowCount       Int
  uploadedById   String
  uploadedBy     User      @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime  @default(now())

  @@map("sku_packaging_uploads")
}

model InventorySnapshot {
  id             String         @id @default(cuid())
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  snapshotDate   DateTime       @db.Date // 재고 기준일 (업로드일과 별개)
  version        Int            @default(1)
  status         SnapshotStatus @default(ACTIVE)
  sourceFileName String
  fileHash       String
  rowCount       Int
  isMock         Boolean        @default(false) // 검증용 mock 데이터 여부 (실데이터와 명확히 분리)
  uploadedById   String
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime       @default(now())

  items      InventoryItem[]
  sourceFile UploadFile?

  @@unique([warehouseId, snapshotDate, version])
  @@index([warehouseId, snapshotDate, status])
  @@map("inventory_snapshots")
}

/// 사용자가 직접 기록한 "해당 날짜까지의 실제 입고 수량". 특정 스냅샷 버전에 종속되지 않고
/// (SKU, 날짜) 단위로 독립적으로 존재한다 — 그날의 재고 스냅샷을 재업로드/교체해도 이 기록은
/// 그대로 남으며, 사용자가 삭제 버튼을 눌러야만 없어진다.
model SnapshotInbound {
  id           String   @id @default(cuid())
  skuId        String
  sku          Sku      @relation(fields: [skuId], references: [id])
  snapshotDate DateTime @db.Date // 입고를 반영할 기준일(해당 날짜까지의 입고로 해석)

  productCode String
  productName String
  quantity    Int
  createdAt   DateTime @default(now())

  @@unique([skuId, snapshotDate])
  @@index([skuId])
  @@map("snapshot_inbounds")
}

/// 업로드 한 번의 품목 한 줄 — 수량·원가처럼 날마다 바뀌는 숫자만 둔다. 가장 많이 쌓이는 표라 칸을 최소로 유지한다.
/// 상품명·옵션·바코드·위치·파일의 위험/경고수량은 날마다 거의 같으므로 바뀐 날만 SkuAttributeVersion에 남긴다.
model InventoryItem {
  snapshotId String
  snapshot   InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  skuId      String
  sku        Sku               @relation(fields: [skuId], references: [id])

  unitCost         Decimal  @default(0) @db.Decimal(14, 2)
  unitCostProvided Boolean  @default(true) // 업로드 행에 원가가 명시됐는지(빈 값이면 직전 SKU 원가를 이어받음)
  totalCost        Decimal? @db.Decimal(24, 2) // 업로드 원가합. null이면 유효 원가 × 정상재고

  normalStock    Int @default(0) // 정상재고
  defectiveStock Int @default(0) // 불량재고
  incomingStock  Int @default(0) // 입고대기

  extra Json? // 직접 입력·재고 0 상태·로트·직접 정한 원가 등 행별 표시와 원본 부가 컬럼(없으면 비움)

  @@id([snapshotId, skuId])
  @@index([skuId])
  @@map("inventory_items")
}

/// SKU의 서술 속성 변경 이력 — 업로드된 값이 그 날짜에 효력 있는 값과 다를 때만 한 줄 남긴다.
/// 과거 날짜로 조회하면 그날 효력이 있던(그 날짜 이하 중 가장 최근) 값을 쓴다.
model SkuAttributeVersion {
  skuId         String
  sku           Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  effectiveDate DateTime @db.Date
  productName   String
  option        String?
  barcode       String?
  location      String?
  warningQty    Int      @default(0)
  dangerQty     Int      @default(0)

  @@id([skuId, effectiveDate])
  @@map("sku_attribute_versions")
}

model InventoryEvent {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  skuId       String? // null이면 창고 전체 메모
  sku         Sku?      @relation(fields: [skuId], references: [id])

  eventType       EventType
  quantity        Int?
  note            String
  eventDate       DateTime // 사용자가 선택한 이벤트 일시(기간 선택 시 시작일)
  // 기간(시작일~종료일) 선택 시 종료일. null이면 하루짜리 이벤트(종료일 = eventDate).
  endDate         DateTime?      @db.Date
  // 제목을 입력하면(선택) 같은 제목·기간·유형의 이벤트를 SKU를 넘나들며 하나의 캘린더
  // 일정(EventSchedule)으로 묶는다. 제목이 없으면 캘린더에는 표시되지 않는 일반 메모로 남는다.
  title           String?
  scheduleId      String?
  schedule        EventSchedule? @relation(fields: [scheduleId], references: [id])
  isAutoGenerated Boolean        @default(false) // "재고 증가 감지" 자동 생성 여부
  isDeleted       Boolean        @default(false) // soft delete (이력 보존)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  history EventHistory[]

  @@index([warehouseId, eventDate])
  @@index([skuId, eventDate])
  @@index([scheduleId])
  @@map("inventory_events")
}

/// 업로드 캘린더에 표시되는 "일정" 단위 — 서로 다른 SKU에 같은 제목·기간·유형으로 등록된
/// InventoryEvent를 하나로 묶어서 보여준다(SKU 단위가 아니라 이벤트명 단위 표시). 색상은
/// 이 그룹 전체에 적용되는 공유 상태라 여기 따로 둔다.
model EventSchedule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  eventType      EventType
  title          String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  color          String       @default("red") // SCHEDULE_COLORS(빨강/주황/연분홍/라임/cyan/연보라) 중 하나
  // 캘린더 일정 패널에서 적은 상세 내용(연결된 SKU 메모에도 같은 내용이 들어간다).
  note           String       @default("")
  // 캘린더 일정 패널에서 만든 일정 — 연결된 SKU·품목이 없어도 캘린더에 보인다(삭제는 패널에서만).
  managed        Boolean      @default(false)

  events InventoryEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, eventType, title, startDate, endDate])
  @@index([organizationId, startDate, endDate])
  @@map("event_schedules")
}

model EventHistory {
  id           String          @id @default(cuid())
  eventId      String
  event        InventoryEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  changeType   EventChangeType
  previousData Json
  changedById  String
  changedBy    User            @relation(fields: [changedById], references: [id])
  changedAt    DateTime        @default(now())

  @@map("event_histories")
}

model Post {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tag            PostTag
  title          String       @db.VarChar(50)
  body           String       @db.VarChar(200)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@map("posts")
}

/// 조직 전체에 적용되는 휴무일(창고별이 아님). 주말과 동일하게 업로드 캘린더에서 업로드를 막고
/// 옅은 회색으로 표시하며, KPI 계산에서는 "매출은 발생하지만 자료 미제출이 정상"인 날로 취급해
/// 직전 영업일 관측치를 stale로 보지 않는다.
model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           DateTime     @db.Date
  name           String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, date])
  @@map("holidays")
}

/// 사용자별 SKU 즐겨찾기. 회사 전체가 공유하는 값이 아니라 각자 자신의 목록만 본다.
model SkuFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skuId     String
  sku       Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, skuId])
  @@index([skuId])
  @@map("sku_favorites")
}

model Settings {
  organizationId            String       @id
  organization              Organization @relation(fields: [organizationId], references: [id])
  stockoutSoonDays          Int          @default(7) // 품절 임박 기준 (Coverage일 <= 값)
  manageMaxDays             Int          @default(30) // 관리필요/정상 경계 (Coverage일 <= 값이면 관리필요)
  overstockCoverageDays     Int          @default(90) // 과잉재고 후보 기준 (Coverage일 >= 값)
  stagnantDays              Int          @default(30) // 장기 정체 기준일 (감소 미관측 기간 >= 값)
  // 비정기 실사: 마지막 실사 후 이 일수가 지나면 다시 세어보길 권한다.
  periodicRecountDays       Int          @default(14)
  // 매장 발주 예측: 남은 매출 여유가 충족 매출의 이 퍼센트 이하면 '발주 확인 필요'.
  storeCheckRemainingPct    Int          @default(20)
  // 일일 재고 연동: 켜면 주말·등록 휴무일에도 업로드를 받는다. 꺼도 이미 올라온 휴무일 자료는 계산에 반영된다.
  allowNonWorkingDayUploads Boolean      @default(false)
  // 일일 재고 연동 발주 기준 기본값(거래처·품목에서 덮어쓸 수 있다)
  reorderLeadTimeDays       Int          @default(3)
  reorderSafetyDays         Int          @default(3)
  reorderTargetDays         Int          @default(14)
  updatedAt                 DateTime     @updatedAt

  @@map("settings")
}

// ── 매장 발주 예측(ORDER_CYCLE) ─────────────────────────────────────────────────────────────
// 재고를 세기 어려운 매장(카페·음식점)은 재고 스냅샷 대신 "언제 얼마나 발주했는지"와 일 매출
// 추이만 기록한다. 발주 사이 간격 동안 직전 발주량을 다 썼다고 보고 하루 사용량을 구한 뒤, 최근
// 매출 증감으로 보정해 다음 발주일을 예측한다.

/// 발주하는 품목(원두, 우유, 컵 등). 이름은 조직 안에서 유일하다.

model PurchaseOrder {
  id               String    @id @default(cuid())
  /// 매장 품목 — '매장 품목' 가상 창고(STORE)의 SKU.
  skuId            String
  sku              Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  orderDate        DateTime  @db.Date
  quantity         Decimal   @db.Decimal(12, 2)
  /// 사용자가 입력한 \"이 발주량으로 감당할 수 있는 매출액\"(원). 비워 두면 과거 기록으로 학습한 값으로 추정한다.
  coverageAmount   Decimal?  @db.Decimal(14, 0)
  /// 이 발주를 넣을 때(받기 전) 남아 있던 양. 비우면 다 쓴 것으로 본다. 입력하면 실제 사용량 기반으로 더 정확히 학습한다.
  leftoverQuantity Decimal?  @db.Decimal(12, 2)
  /// 이 발주분의 소비기한(선택). 관리가 필요한 품목만 입력하고, 입력한 품목은 대시보드에서 임박 여부를 따라간다.
  expirationDate   DateTime? @db.Date
  createdById      String
  createdBy        User      @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())

  @@index([skuId, orderDate])
  @@map("purchase_orders")
}

/// Easy Count — 매장 품목을 직접 센 기록. 미개봉 완제품 개수(EA)와 개봉품 잔량(%)을 나눠 적는다.
/// 같은 품목·같은 날짜는 하나만 둔다(다시 저장하면 덮어쓴다).
model StoreStockCount {
  id            String   @id @default(cuid())
  /// 매장 품목 — '매장 품목' 가상 창고(STORE)의 SKU.
  skuId         String
  sku           Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  countDate     DateTime @db.Date
  /// 미개봉 완제품 개수(품목 단위).
  fullUnits     Decimal  @db.Decimal(12, 2)
  /// 개봉한 제품의 남은 양(0~100%). 개봉품이 없으면 null.
  openedPercent Int?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([skuId, countDate])
  @@map("store_stock_counts")
}

/// 하루 매출 합계(원). 같은 날짜를 다시 입력하면 덮어쓴다.
model DailySales {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           DateTime     @db.Date
  amount         Decimal      @db.Decimal(14, 0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, date])
  @@map("daily_sales")
}

/// 운영자 콘솔에서 한 조치 기록. 워크스페이스가 삭제돼도 기록은 남도록 조직은 외래키 없이 id·이름만 복사해 둔다.
model PlatformAuditLog {
  id               String   @id @default(cuid())
  actorId          String
  actor            User     @relation(fields: [actorId], references: [id])
  action           String
  organizationId   String?
  organizationName String?
  detail           Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@map("platform_audit_logs")
}

/// 매장 발주처(거래처). 품목에 연결하면 발주처의 리드타임으로 발주 확인 시점을 앞당긴다.
model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  leadTimeDays   Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // 일일 재고 연동 발주 기준 — 비어 있으면 워크스페이스 기본값. 리드타임은 매장 발주 예측과 함께 쓴다.
  safetyDays    Int?
  targetDays    Int?
  minOrderQty   Int?
  orderMultiple Int?

  skus Sku[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("suppliers")
}

/// 재고 파일 양식 템플릿 — 업체마다 다른 엑셀 양식을 한 번 확인해 두면 다음 업로드부터 자동 적용된다.
/// 헤더 행의 지문(열 이름 집합)으로 같은 양식인지 알아본다.
model ImportTemplate {
  id                 String          @id @default(cuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id])
  name               String
  /// 이 양식을 쓰는 방식(일일 재고 연동 / 비정기 실사). 같은 파일 모양이라도 방식마다 따로 저장한다.
  segment            BusinessSegment @default(DAILY_SYNC)
  fingerprint        String
  sheetName          String?
  headerRowIndex     Int
  /// 필드별 헤더 이름 { productCode: "품번", ... }
  columns            Json
  /// 같은 상품코드 여러 행: sum(합산) | skip(첫 행만)
  duplicateMode      String          @default("sum")
  /// 재고수량 단위(EA|BOX|PLT). null이면 낱개.
  stockUnit          String?
  /// 재고 0인 행을 품절로 볼지(true: 품절 — 1개월간 품절 목록 노출 / false: 관리 품목에서 제외 — 대시보드에 안 보임). null이면 true.
  zeroStockAsSoldOut Boolean?
  lastUsedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([organizationId, segment, fingerprint])
  @@index([organizationId])
  @@map("import_templates")
}

/// 창고 안에서 파일의 다른 상품코드(업체 코드 변경, 바코드로 내보낸 파일 등)를 기존 SKU로 잇는 연결.
/// 업로드 때 이 코드로 들어온 행은 연결된 SKU의 코드로 저장된다.
model SkuCodeAlias {
  id           String    @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  externalCode String
  skuId        String
  sku          Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@unique([warehouseId, externalCode])
  @@index([skuId])
  @@map("sku_code_aliases")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// 메일 링크용 일회성 토큰. 원문은 메일에만 담고 DB에는 SHA-256 해시만 둔다.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@map("auth_tokens")
}

/// 팀 초대. 링크를 받은 사람이 이름·비밀번호를 정하면 이 워크스페이스의 사용자가 된다.
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(MEMBER)
  tokenHash      String       @unique
  invitedById    String?
  invitedBy      User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("invitations")
}

enum UploadJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// 큰 재고 파일은 응답을 먼저 돌려주고 뒤에서 처리한다. 화면은 이 상태를 조회해 결과를 보여준다.
model UploadJob {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  warehouseId    String
  snapshotDate   DateTime        @db.Date
  fileName       String
  fileSize       Int
  status         UploadJobStatus @default(QUEUED)
  /// 처리 결과(업로드 응답과 같은 모양) 또는 오류 메시지.
  result         Json?
  error          String?
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([organizationId, createdAt])
  @@map("upload_jobs")
}

enum CostSource {
  FILE
  MANUAL
}

/// 재고 업로드의 원본 파일. 업로드 버전(스냅샷)마다 하나씩 보관해 나중에 그대로 내려받을 수 있다.
/// 스냅샷(자료 초기화)이나 워크스페이스를 지우면 함께 지워지고, 보관 기한(UPLOAD_FILE_RETENTION_DAYS)이 지나면 정리된다.
/// 내용은 객체 저장소(S3 호환, storageKey)에 두는 것이 기본이고, 저장소를 설정하지 않은 환경에서만 DB(data)에 둔다.
model UploadFile {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshotId     String            @unique
  snapshot       InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  fileName       String
  contentType    String
  size           Int
  sha256         String
  /// 객체 저장소를 쓰지 않을 때만 채운다.
  data           Bytes?
  /// 객체 저장소의 키. 채워져 있으면 내용은 저장소에 있다.
  storageKey     String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@map("upload_files")
}
