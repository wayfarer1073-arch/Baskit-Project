# 로컬 개발: 네이티브 PostgreSQL 또는 Docker Postgres
# 운영 배포: Supabase(또는 다른 관리형 Postgres) 프로젝트의 Connection string 그대로 사용 가능
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scm_inventory?schema=public"

# openssl rand -base64 32 로 생성 권장
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# ── 업로드 원본 파일 저장소(선택) ──────────────────────────────────────────
# 설정하면 원본 엑셀·CSV를 DB 대신 S3 호환 저장소(Cloudflare R2, AWS S3, Supabase Storage, MinIO)에 둔다.
# 비워 두면 DB에 저장한다(로컬 개발 기본값). 기존 파일은 설정 후 `npm run db:move-files`로 옮긴다.
FILE_STORAGE_BUCKET=""
FILE_STORAGE_REGION="auto"
FILE_STORAGE_ENDPOINT=""          # R2 예: https://<account-id>.r2.cloudflarestorage.com (AWS S3면 비움)
FILE_STORAGE_ACCESS_KEY_ID=""
FILE_STORAGE_SECRET_ACCESS_KEY=""
FILE_STORAGE_FORCE_PATH_STYLE="false"  # MinIO·Supabase Storage는 true

# ── 보관 기한 정리(하루 한 번 /api/cron/maintenance 호출) ────────────────────
# 스케줄러가 `Authorization: Bearer <CRON_SECRET>` 헤더로 부른다. 비워 두면 정리 API는 동작하지 않는다.
CRON_SECRET=""
# 기한(일). 0이면 그 항목은 지우지 않는다.
UPLOAD_FILE_RETENTION_DAYS="180"
UPLOAD_JOB_RETENTION_DAYS="30"
AUTH_TOKEN_RETENTION_DAYS="7"
INVITATION_RETENTION_DAYS="30"
AUDIT_LOG_RETENTION_DAYS="730"
